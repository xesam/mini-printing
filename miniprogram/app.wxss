page {
    height: 100vh;
    background: #f7f8fa;
    font-size: 28rpx;
    color: #323233;

    --brand: #1989fa;
    --brand-plain: #e8f3ff;
    --success: #07c160;
    --danger: #ee0a24;
    --warning: #ff976a;
    --purple: #7232dd;
    --text-primary: #323233;
    --text-secondary: #969799;
    --text-weak: #c8c9cc;
    --border-color: #ebedf0;
}

.page-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

.page-scrollarea {
    flex: 1;
    overflow-y: hidden;
}

.page-toolbar {
    padding: 24rpx;
}

/* 布局 */
.section {
    margin: 24rpx;
}

.section + .section {
    margin-top: 8rpx;
}

/* 卡片 */
.card {
    background: #ffffff;
    border-radius: 24rpx;
    padding: 32rpx;
    box-sizing: border-box;
}

.view--hover {
    opacity: 0.7;
}

/* 区块标题 */
.ctrl-title {
    padding: 8rpx 8rpx 16rpx;
    color: var(--text-secondary);
    font-size: 26rpx;
}

/* 按钮 */
.btn {
    margin: 0;
    padding: 0 32rpx;
    height: 88rpx;
    line-height: 88rpx;
    border-radius: 44rpx;
    font-size: 32rpx;
    text-align: center;
    box-sizing: border-box;
    width: 100%;
}

.btn::after {
    border: none;
}

.btn--primary {
    background: var(--brand);
    color: #ffffff;
}

.btn--secondary {
    background: #ffffff;
    color: var(--brand);
    border: 2rpx solid var(--brand);
}

.btn--block {
    width: 100%;
    display: block;
}

.btn--hover {
    opacity: 0.8;
}

/* 文字操作 */
.link-action {
    color: var(--brand);
    font-size: 28rpx;
    padding: 12rpx 16rpx;
}

/* 右箭头 */
.chevron {
    width: 14rpx;
    height: 14rpx;
    border-top: 4rpx solid var(--text-weak);
    border-right: 4rpx solid var(--text-weak);
    transform: rotate(45deg);
    box-sizing: border-box;
}

/* 底部操作栏 */
.bottom-bar {
    padding: 16rpx 24rpx;
}

/* 骨架屏 */
.skeleton--block {
    height: 32rpx;
    border-radius: 8rpx;
    background: #f2f3f5;
    margin-bottom: 24rpx;
    animation: skeleton-blink 1.2s ease infinite;
}

.skeleton--w60 {
    width: 60%;
}

.skeleton--w40 {
    width: 40%;
}

@keyframes skeleton-blink {
    0% {
        opacity: 0.6;
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: 0.6;
    }
}
