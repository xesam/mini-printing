.segmented {
    display: flex;
    flex-direction: row;
    align-items: center;
    background: #f7f8fa;
    border-radius: 12rpx;
    padding: 8rpx;
}

.segmented__item {
    flex: 1;
    height: 72rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12rpx;
    font-size: 28rpx;
    color: var(--text-secondary, #969799);
}

.segmented__item--active {
    background: #ffffff;
    color: var(--brand, #1989fa);
    font-weight: 600;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.segmented__item--hover {
    opacity: 0.8;
}
