<view class="page-container">
    <navigation-bar title="帮助" back="{{true}}" color="black" background="#fff"></navigation-bar>
    <scroll-view class="page-scrollarea page--help" scroll-y type="list">
        <view class="section">
            <view class="notice-card">本小程序不远程保存任何信息，小程序后台认证的服务器域名只包含各个开放平台的接口域名。</view>
        </view>
        <view class="section">
            <view class="help-title">开放平台账号说明</view>
            <view class="help-p">由于不同开放平台对账号字段的叫法不一样，因此在管理开放平台账号的时候，需要注意平台间差异：</view>
            <view class="card brand-guide">
                <view class="brand-guide__header">
                    <brand-tag brand="FEIE" name="飞鹅"/>
                </view>
                <view class="brand-guide__row">
                    <text class="brand-guide__term">USER</text>
                    <text class="brand-guide__arrow">→</text>
                    <text class="brand-guide__field">AppId</text>
                </view>
                <view class="brand-guide__row">
                    <text class="brand-guide__term">UKEY</text>
                    <text class="brand-guide__arrow">→</text>
                    <text class="brand-guide__field">Secret</text>
                </view>
            </view>
            <view class="card brand-guide">
                <view class="brand-guide__header">
                    <brand-tag brand="XPYUN" name="芯烨"/>
                </view>
                <view class="brand-guide__row">
                    <text class="brand-guide__term">开发者ID</text>
                    <text class="brand-guide__arrow">→</text>
                    <text class="brand-guide__field">AppId</text>
                </view>
                <view class="brand-guide__row">
                    <text class="brand-guide__term">开发者密钥</text>
                    <text class="brand-guide__arrow">→</text>
                    <text class="brand-guide__field">Secret</text>
                </view>
            </view>
            <view class="card brand-guide">
                <view class="brand-guide__header">
                    <brand-tag brand="SPYUN" name="商鹏"/>
                </view>
                <view class="brand-guide__row">
                    <text class="brand-guide__term">appid</text>
                    <text class="brand-guide__arrow">→</text>
                    <text class="brand-guide__field">AppId</text>
                </view>
                <view class="brand-guide__row">
                    <text class="brand-guide__term">appsecret</text>
                    <text class="brand-guide__arrow">→</text>
                    <text class="brand-guide__field">Secret</text>
                </view>
            </view>
        </view>
        <view class="section">
            <view class="help-title">联系我</view>
            <view class="card contact-card">
                <view class="contact-card__label">邮箱</view>
                <text class="contact-card__value" user-select>xesam@outlook.com</text>
            </view>
        </view>
    </scroll-view>
</view>
