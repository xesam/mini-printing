.account-card {
    display: flex;
    align-items: center;
}

.account-card__icon {
    width: 88rpx;
    height: 88rpx;
    margin-right: 24rpx;
    border-radius: 16rpx;
    flex-shrink: 0;
}

.account-card__body {
    flex: 1;
    min-width: 0;
}

.account-card__brand {
    font-size: 32rpx;
    font-weight: 600;
    color: var(--text-primary);
}

.account-card__appid {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: var(--text-secondary);
    font-family: "Menlo", "Consolas", monospace;
    word-break: break-all;
}

.account-card__appid--muted {
    color: var(--text-weak);
    font-family: inherit;
}

.account-card__action {
    display: flex;
    align-items: center;
    margin-left: 16rpx;
    color: var(--brand);
    font-size: 26rpx;
}

.account-card__chevron {
    margin-left: 8rpx;
    border-top-color: var(--brand);
    border-right-color: var(--brand);
}

.search-bar {
    display: flex;
    align-items: center;
}

.search-bar__field {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    height: 80rpx;
    padding: 0 24rpx;
    background: #ffffff;
    border-radius: 40rpx;
    box-sizing: border-box;
}

.search-bar__icon {
    position: relative;
    width: 28rpx;
    height: 28rpx;
    flex-shrink: 0;
}

.search-bar__icon-circle {
    width: 20rpx;
    height: 20rpx;
    border: 3rpx solid var(--text-weak);
    border-radius: 50%;
    box-sizing: border-box;
}

.search-bar__icon-handle {
    position: absolute;
    right: 0;
    bottom: 2rpx;
    width: 10rpx;
    height: 3rpx;
    background: var(--text-weak);
    transform: rotate(45deg);
}

.search-bar__input {
    flex: 1;
    min-width: 0;
    height: 80rpx;
    margin-left: 16rpx;
    font-size: 28rpx;
}

.search-bar__clear {
    padding: 8rpx 4rpx 8rpx 16rpx;
    color: var(--text-weak);
    font-size: 32rpx;
    line-height: 1;
}

.search-bar__action {
    padding: 12rpx 8rpx 12rpx 24rpx;
    color: var(--brand);
    font-size: 30rpx;
    flex-shrink: 0;
}

.state-card--fail {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48rpx 32rpx;
}

.state-card--fail__msg {
    font-size: 28rpx;
    color: var(--text-secondary);
    text-align: center;
    word-break: break-all;
}

.state-card--fail__retry {
    margin-top: 24rpx;
    color: var(--brand);
    font-size: 28rpx;
    padding: 12rpx 32rpx;
}
